# ==========================================
# SANGYAN SHIELD - Environment Variables
# ==========================================

# Frontend (Vite)
VITE_API_URL=http://localhost:8000

# Backend (FastAPI)
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL / Supabase - Optional in ephemeral MVP)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sangyan_shield
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional LLM for translation/summarization only (Section 40)
# Note: Structured safety scoring is authoritative. LLM never overrides rules.
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
